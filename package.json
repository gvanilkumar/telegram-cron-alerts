{
  "name": "telegram-cron-alerts",
  "version": "1.0.0",
  "description": "Serverless Telegram alerting system powered by GitHub Actions and Gemini AI",
  "main": "server.js",
  "scripts": {
    "install-all": "npm install && npm --prefix frontend install",
    "build": "npm --prefix frontend run build",
    "ui": "node server.js",
    "dev": "concurrently \"node server.js\" \"npm --prefix frontend run dev\"",
    "test-runner": "node runner.js"
  },
  "dependencies": {
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "open": "^10.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "private": true
}
